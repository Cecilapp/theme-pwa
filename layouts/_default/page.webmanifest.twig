{#- options (`manifest` at the root of the configuration is deprecated since 3.0) #}
{%- set manifest = (site.pwa.manifest ?? {})|merge(site.manifest ?? {}) %}
{#- icons #}
{%- set icons = [] %}
{%- if manifest.icons|default([])|length > 0 %}
  {%- for icon in manifest.icons %}
    {#- icon with options #}
    {%- if icon is iterable %}
      {%- set icon_asset = asset(icon.src) %}
      {%- set icons = icons|merge([{
        src: icon_asset|url,
        sizes: icon.sizes|default(icon_asset.width ~ 'x' ~ icon_asset.height),
        type: icon.type|default(icon_asset.subtype),
        purpose: icon.purpose|default('any'),
      }]) %}
    {#- icon file only #}
    {%- else %}
      {%- set icon_asset = asset(icon) %}
      {%- set icons = icons|merge([{
        src: icon_asset|url,
        sizes: icon_asset.width ~ 'x' ~ icon_asset.height,
        type: icon_asset.subtype,
      }]) %}
    {%- endif %}
  {%- endfor %}
{%- else %}
  {#- creates icons from the website `icon.png` file, or from the theme one #}
  {%- set icon_asset = asset('icon.png', {ignore_missing: true}) %}
  {%- if icon_asset.missing %}
    {%- set icon_asset = asset('pwa/icon.png', {ignore_missing: true}) %}
  {%- endif %}
  {%- if not icon_asset.missing %}
    {%- for purpose in ['any', 'maskable'] %}
      {%- for size in [192, 512] %}
        {%- set resized = purpose == 'maskable' ? icon_asset|resize(size)|maskable : icon_asset|resize(size) %}
        {%- set icon = {
          src: resized|url,
          sizes: resized.width ~ 'x' ~ resized.height,
          type: resized.subtype,
        } %}
        {%- if purpose == 'maskable' %}
          {%- set icon = icon|merge({purpose: 'maskable'}) %}
        {%- endif %}
        {%- set icons = icons|merge([icon]) %}
      {%- endfor %}
    {%- endfor %}
  {%- endif %}
{%- endif %}
{#- screenshots #}
{%- set screenshots = [] %}
{%- for screenshot in manifest.screenshots|default([]) %}
  {%- set screenshot_asset = asset(screenshot) %}
  {%- set screenshots = screenshots|merge([{
    src: screenshot_asset|url,
    sizes: screenshot_asset.width ~ 'x' ~ screenshot_asset.height,
    type: screenshot_asset.subtype,
    form_factor: screenshot_asset.width < screenshot_asset.height ? 'narrow' : 'wide',
  }]) %}
{%- endfor %}
{#- shortcuts #}
{%- set shortcuts = [] %}
{%- if manifest.shortcuts|default(false) and site.menus.main|length > 0 %}
  {#- website `icon-link.png` file, or the theme one #}
  {%- set shortcut_icon = asset('icon-link.png', {ignore_missing: true}) %}
  {%- if shortcut_icon.missing %}
    {%- set shortcut_icon = asset('pwa/icon-link.png') %}
  {%- endif %}
  {%- for item in site.menus.main|filter(i => 'http' not in i.url)|sort_by_weight %}
    {%- set shortcuts = shortcuts|merge([{
      name: item.name,
      url: url(item.url),
      icons: [{
        src: shortcut_icon|url,
        sizes: shortcut_icon.width ~ 'x' ~ shortcut_icon.height,
        type: shortcut_icon.subtype,
      }],
    }]) %}
  {%- endfor %}
{%- endif %}
{#- short name: title truncated to 12 characters, without cutting a word #}
{%- set short_name = site.title %}
{%- if short_name|length > 12 %}
  {%- set short_name = '' %}
  {%- set truncated = false %}
  {%- for word in site.title|split(' ') %}
    {%- if not truncated and (short_name ~ ' ' ~ word)|trim|length <= 12 %}
      {%- set short_name = (short_name ~ ' ' ~ word)|trim %}
    {%- else %}
      {%- set truncated = true %}
    {%- endif %}
  {%- endfor %}
  {%- if short_name is empty %}
    {%- set short_name = site.title[:12] %}
  {%- endif %}
{%- endif %}
{#- main #}
{%- set display_override = manifest.display_override|default('standalone') %}
{%- set webmanifest = {
  name: manifest.name|default(site.title),
  short_name: manifest.short_name|default(short_name),
  description: manifest.description|default(site.description|default('')),
  display_override: display_override is iterable ? display_override : [display_override],
  display: manifest.display|default('standalone'),
  start_url: manifest.start_url|default(url(site.home, {canonical: true})),
  id: manifest.id|default(url(site.home, {canonical: true})),
  orientation: manifest.orientation|default('any'),
  background_color: manifest.background_color|default('#FFFFFF'),
  theme_color: manifest.theme_color|default('#202020'),
  lang: site.language|default('en') ~ '',
  dir: manifest.dir|default('ltr'),
  icons: icons,
} %}
{%- if screenshots|length > 0 %}
  {%- set webmanifest = webmanifest|merge({screenshots: screenshots}) %}
{%- endif %}
{%- if shortcuts|length > 0 %}
  {%- set webmanifest = webmanifest|merge({shortcuts: shortcuts}) %}
{%- endif %}
{{- webmanifest|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw -}}