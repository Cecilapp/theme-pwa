var CACHE_VERSION = '{{ site.time|e('js') }}';
var CACHE_NAME = '{{ site.title|slugify|e('js') }}';
var CACHE_PREFIX = CACHE_NAME + '-v';
var CACHE = CACHE_PREFIX + CACHE_VERSION;
var PATH_TO_IGNORE = [];
{% if site.serviceworker.ignore is defined and site.serviceworker.ignore %}
var PATH_TO_IGNORE = [{% for i in site.serviceworker.ignore %}'{{ i.path|e('js') }}'{% if not loop.last %}, {% endif %}{% endfor %}];
{% endif %}

// offline pages, by language
var OFFLINE_PAGES = [];
{%- set offline_id = site.serviceworker.offline.page|default('offline') %}
{%- for language in site.languages %}
  {%- set offline_page = site.page(offline_id, language.code) %}
  {%- set home_page = site.page('index', language.code) %}
  {%- if offline_page is not null and home_page is not null ~%}
OFFLINE_PAGES.push({ prefix: '{{ url(home_page, {canonical: false})|e('js') }}', url: '{{ url(offline_page, {canonical: false})|e('js') }}' });
  {%- endif %}
{%- endfor %}

// the most specific prefix first (e.g. "/fr/" before "/")
OFFLINE_PAGES.sort((a, b) => b.prefix.length - a.prefix.length);

// prepares precache
var precache = [];
{% if site.serviceworker.install.precache.icons ?? false and site.manifest.icons|default([])|length > 0 %}
// icons
  {%- for icon in site.manifest.icons|default([]) %}
    {%- if icon is iterable ~%}
precache.push('{{ asset(icon.src)|url({canonical: false})|e('js') }}');
    {%- else ~%}
precache.push('{{ asset(icon)|url({canonical: false})|e('js') }}');
    {%- endif ~%}
  {%- endfor ~%}
{% endif %}
// pages
{% set pages_to_precache = site.allpages|filter(p => p.published == true and p.redirect is not defined and (p.serviceworker.precache ?? true) != false)|sort((a, b) => a.path > b.path) %}
{% for page in pages_to_precache|slice(0, (site.serviceworker.install.precache.pages.limit ?? false) == false ? pages_to_precache|length : site.serviceworker.install.precache.pages.limit) %}
precache.push('{{ url(page, {canonical: false})|e('js') }}');
{% endfor %}
{%- block precache %}{% endblock -%}
{% if site.serviceworker.install.precache.assets is defined %}
// assets
  {%- for file in site.serviceworker.install.precache.assets ~%}
precache.push('{{ asset(file)|url({canonical: false})|e('js') }}');
  {%- endfor ~%}
{% endif %}
// offline pages are always precached
OFFLINE_PAGES.forEach(function (offline) {
  precache.push(offline.url);
});
precache = [...new Set(precache)];

// install and precache
self.addEventListener('install', function(event) {
  self.skipWaiting(); // install the new SW immediately
  {%- if site.debug|default(false) ~%}
  console.log('[SW] Install');
  {%- endif ~%}
  event.waitUntil(
    caches.open(CACHE).then(function(cache) {
      {%- if site.debug|default(false) ~%}
      console.log(`[SW] Create cache storage "${CACHE}"`);
      {%- endif ~%}
      return Promise.allSettled(precache.map(async function (path) {
        // reuses the response stored by a previous version, if any (refreshed later by the fetch strategies)
        const cached = await caches.match(path);
        if (cached) {
          return cache.put(path, cached);
        }
        {%- if site.debug|default(false) ~%}
        console.log('[SW] Precache', path);
        {%- endif ~%}
        return cache.add(new Request(path, {cache: '{{ site.serviceworker.cache.request|default('reload')|e('js') }}'})).catch(error => console.error(`[SW] Can't add "${path}" to cache`));
      }));
    })
  );
});

// activate and remove old cache
self.addEventListener('activate', function(event) {
  {%- if site.debug|default(false) ~%}
  console.log('[SW] Activate');
  {%- endif ~%}
  const activate = async () => {
    // checks cache version
    const keyList = await caches.keys();
    await Promise.all(keyList.map(function(key) {
      // obsolete cache of this website?
      if (key.startsWith(CACHE_PREFIX) && key !== CACHE) {
        {%- if site.debug|default(false) ~%}
        console.log(`[SW] Remove old cache storage "${key}"`);
        {%- endif ~%}
        return caches.delete(key);
      }
    }));
    // claim clients immediately
    await self.clients.claim();
  };
  event.waitUntil(activate());
});

// pages (HTML) strategy: 'network-first' or 'cache-first'
var PAGES_STRATEGY = '{{ site.serviceworker.cache.strategy|default('network-first')|e('js') }}';

// is it a page request?
function isPage(request) {
  return request.mode === 'navigate' || request.headers.get('Accept')?.includes('text/html');
}

// stores a valid response in the cache
function putInCache(event, response) {
  if (!response || response.status !== 200 || response.type !== 'basic') {
    return;
  }
  {%- if site.debug|default(false) ~%}
  console.log('[SW] Put to cache', event.request.url);
  {%- endif ~%}
  const responseToCache = response.clone();
  event.waitUntil(caches.open(CACHE).then(cache => cache.put(event.request, responseToCache)));
}

// offline fallback: offline page (of the current language) or image placeholder
async function offlineFallback(request) {
  if (isPage(request)) {
    const url = new URL(request.url);
    const offline = OFFLINE_PAGES.find(page => url.pathname.startsWith(page.prefix));
    if (offline !== undefined) {
      const response = await caches.match(offline.url);
      if (response) {
        return response;
      }
    }
  }
  if (request.destination === 'image') {
    return new Response('<svg role="img" aria-labelledby="offline-title" viewBox="-102.4 -102.4 716.80 716.80" xmlns="http://www.w3.org/2000/svg" fill="#505050" stroke="#505050"><title id="offline-title">{{ 'Offline'|trans|e('html')|e('js') }}</title><g><path d="M93.72,183.25C49.49,198.05,16,233.1,16,288c0,66,54,112,120,112H320.37" style="fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px"></path><path d="M467.82,377.74C485.24,363.3,496,341.61,496,312c0-59.82-53-85.76-96-88-8.89-89.54-71-144-144-144-26.16,0-48.79,6.93-67.6,18.14" style="fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px"></path><line x1="448" y1="448" x2="64" y2="64" style="fill:none;stroke-linecap:round;stroke-miterlimit:10;stroke-width:32px"></line></g></svg>', { headers: { 'Content-Type': 'image/svg+xml' } });
  }
  return Response.error();
}

// network first, then cache, then offline fallback
async function networkFirst(event) {
  try {
    const response = await fetch(event.request);
    putInCache(event, response);
    return response;
  } catch (error) {
    const cached = await caches.match(event.request);
    {%- if site.debug|default(false) ~%}
    if (cached) {
      console.log('[SW] Response from cache (offline)', event.request.url);
    }
    {%- endif ~%}
    return cached || offlineFallback(event.request);
  }
}

// cache first, then network, then offline fallback
async function cacheFirst(event) {
  const cached = await caches.match(event.request);
  if (cached) {
    {%- if site.debug|default(false) ~%}
    console.log('[SW] Response from cache', event.request.url);
    {%- endif ~%}
    return cached;
  }
  try {
    const response = await fetch(event.request);
    putInCache(event, response);
    return response;
  } catch (error) {
    return offlineFallback(event.request);
  }
}

// cache first and refresh the cache in the background, or network then offline fallback
async function staleWhileRevalidate(event) {
  const cached = await caches.match(event.request);
  const network = fetch(event.request).then(response => {
    putInCache(event, response);
    return response;
  });
  if (cached) {
    {%- if site.debug|default(false) ~%}
    console.log('[SW] Response from cache (revalidating)', event.request.url);
    {%- endif ~%}
    event.waitUntil(network.catch(() => {}));
    return cached;
  }
  try {
    return await network;
  } catch (error) {
    return offlineFallback(event.request);
  }
}

// fetch
self.addEventListener('fetch', function(event) {
  const url = new URL(event.request.url);
  // ignores...
  // ...not GET requests
  if (event.request.method !== 'GET') {
    return;
  }
  // ...not HTTP requests (ie "data:", "chrome-extension:", etc.)
  if (!url.protocol.startsWith('http')) {
    return;
  }
  // ...not local resources, except images
  if (url.origin !== location.origin && event.request.destination !== 'image') {
    return;
  }
  // ...Cecil's watcher
  if (url.pathname.endsWith('/watcher')) {
    return;
  }
  // ...optional paths
  const ignoredPath = PATH_TO_IGNORE.find(path => url.pathname.startsWith(path));
  if (ignoredPath !== undefined) {
    {%- if site.debug|default(false) ~%}
    console.log('[SW] Ignore', ignoredPath);
    {%- endif ~%}
    return;
  }
  {%- if site.debug|default(false) ~%}
  console.log('[SW] Fetch', event.request.url);
  {%- endif ~%}
  // cross-origin images: network only (opaque responses are not cached), placeholder when offline
  if (url.origin !== location.origin) {
    event.respondWith(fetch(event.request).catch(() => offlineFallback(event.request)));
    return;
  }
  // pages
  if (isPage(event.request)) {
    event.respondWith(PAGES_STRATEGY === 'cache-first' ? cacheFirst(event) : networkFirst(event));
    return;
  }
  // assets
  event.respondWith(staleWhileRevalidate(event));
});

{%- if site.serviceworker.update.notification|default(false) ~%}
// notification click
self.addEventListener('notificationclick', (event) => {
  event.notification.close();
  event.waitUntil(
    clients.matchAll({ type: 'window' }).then((clientList) => {
      const hadWindowToFocus = clientList.some((windowClient) => windowClient.url.startsWith(self.registration.scope) ? (windowClient.focus(), true) : false);
      if (!hadWindowToFocus) {
        clients.openWindow(self.registration.scope).then((windowClient) => (windowClient ? windowClient.focus() : null));
      }
    })
  );
});
{%- endif %}